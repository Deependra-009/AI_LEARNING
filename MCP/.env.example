# GitPilot environment variables
# Copy to .env and export before running the backend:
#   export $(grep -v '^#' .env | xargs)

# Phase 1 — GitHub PAT (local dev)
GITHUB_PAT=

# Phase 3 — LLM
ANTHROPIC_API_KEY=

# Phase 4 — GitHub OAuth
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Phase 4+ — Database (H2 default for local dev later)
# DB_URL=jdbc:postgresql://localhost:5432/gitpilot
# DB_USERNAME=gitpilot
# DB_PASSWORD=

# Frontend (Phase 5)
# NEXT_PUBLIC_BACKEND_URL=http://localhost:8080
